#!/usr/bin/env bash

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
HYPE_DIR="$CONFIG_DIR/hype"
if [ -n "${HYPESHELL_HYPRLAND_CONFIG:-}" ]; then
    CONFIG_FILE="$HYPESHELL_HYPRLAND_CONFIG"
elif [ -f "$CONFIG_DIR/hyprland.lua" ]; then
    CONFIG_FILE="$CONFIG_DIR/hyprland.lua"
elif [ -f "$CONFIG_DIR/hyprland.conf" ]; then
    CONFIG_FILE="$CONFIG_DIR/hyprland.conf"
else
    CONFIG_FILE="$CONFIG_DIR/hyprland.lua"
fi
DEFAULT_DIR="${HYPESHELL_HYPRLAND_DEFAULTS:-/usr/local/share/hypeshell/hyprland}"
export PATH="/usr/local/bin:/usr/bin:/bin:${PATH:-}"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            shift
            ;;
        -c|--config)
            if [ "$#" -lt 2 ]; then
                echo "Error: $1 requires a config path." >&2
                exit 2
            fi
            CONFIG_FILE="$2"
            shift 2
            ;;
        *)
            echo "Warning: ignoring unknown Hyprland session option: $1" >&2
            shift
            ;;
    esac
done

seed_config() {
    local source_file="$1"
    local target_file="$2"

    if [ -s "$target_file" ] || [ ! -r "$source_file" ]; then
        return 0
    fi

    mkdir -p "$(dirname "$target_file")"
    cp "$source_file" "$target_file"
}

repair_config_placeholders() {
    local target_file="$1"

    if [ -f "$target_file" ] && grep -q '{{TERMINAL_COMMAND}}' "$target_file"; then
        sed -i 's/{{TERMINAL_COMMAND}}/kitty/g' "$target_file"
    fi
}

mkdir -p "$CONFIG_DIR" "$HYPE_DIR"
if [[ "$CONFIG_FILE" == *.lua ]]; then
    seed_config "$DEFAULT_DIR/hyprland.lua" "$CONFIG_FILE"
else
    seed_config "$DEFAULT_DIR/hyprland.conf" "$CONFIG_FILE"
fi
seed_config "$DEFAULT_DIR/hype/colors.lua" "$HYPE_DIR/colors.lua"
seed_config "$DEFAULT_DIR/hype/layout.lua" "$HYPE_DIR/layout.lua"
seed_config "$DEFAULT_DIR/hype/binds.lua" "$HYPE_DIR/binds.lua"
seed_config "$DEFAULT_DIR/hype/outputs.lua" "$HYPE_DIR/outputs.lua"
seed_config "$DEFAULT_DIR/hype/cursor.lua" "$HYPE_DIR/cursor.lua"
seed_config "$DEFAULT_DIR/hype/windowrules.lua" "$HYPE_DIR/windowrules.lua"
seed_config "$DEFAULT_DIR/hype/hardware.lua" "$HYPE_DIR/hardware.lua"
repair_config_placeholders "$CONFIG_FILE"
repair_config_placeholders "$HYPE_DIR/binds.lua"

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-hypeshell-hyprland}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"

if [ -z "${QT_QPA_PLATFORMTHEME:-}" ]; then
    if command -v qt6ct >/dev/null 2>&1; then
        export QT_QPA_PLATFORMTHEME="qt6ct"
    else
        export QT_QPA_PLATFORMTHEME="gtk3"
    fi
else
    export QT_QPA_PLATFORMTHEME
fi
export QT_QPA_PLATFORMTHEME_QT6="${QT_QPA_PLATFORMTHEME_QT6:-$QT_QPA_PLATFORMTHEME}"

if [ -z "${XDG_MENU_PREFIX:-}" ] && [ -f /etc/xdg/menus/arch-applications.menu ]; then
    export XDG_MENU_PREFIX="arch-"
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME QT_QPA_PLATFORMTHEME_QT6 ${XDG_MENU_PREFIX:+XDG_MENU_PREFIX} || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME QT_QPA_PLATFORMTHEME_QT6 ${XDG_MENU_PREFIX:+XDG_MENU_PREFIX} || true
fi

if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland -- --config "$CONFIG_FILE"
fi

if command -v Hyprland >/dev/null 2>&1; then
    echo "Warning: start-hyprland was not found; falling back to Hyprland directly." >&2
    exec Hyprland -c "$CONFIG_FILE"
fi

echo "Error: Hyprland is not installed or not in PATH." >&2
exit 127
